[Unit]
Description=ASUS EC fan status cache for Proxmox VE
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/share/pve-local-thermal/fan-cache.py serve
RuntimeDirectory=asus-ec-fan
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=10
TimeoutStopSec=5
KillMode=control-group
UMask=0022
Nice=10

[Install]
WantedBy=multi-user.target
